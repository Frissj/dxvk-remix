/*
  
  Shader Description
  ==================
  
  Only used for TARGETS_RAY_TRACING
  
  This compute shader assigns the blasReference address to each
  tlas instance description prior updating the tlas and after
  the per-frame blas were built.

  A single thread represents one instance
*/

#version 460


#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : enable
#extension GL_EXT_buffer_reference : enable
#extension GL_EXT_buffer_reference2 : enable
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_shader_atomic_int64 : enable

#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#include "shaderio.h"

// NV-DXVK: [BlasHeadScan] raw u64 reader for dereferencing a blasReference
// address (see Readback::dbgBlasHeads)
layout(buffer_reference, buffer_reference_align=8, scalar) buffer BlasHeadRef
{
  uint64_t d[];
};

layout(scalar, binding = BINDINGS_FRAME_UBO, set = 0) uniform frameConstantsBuffer
{
  FrameConstants view;
};

layout(scalar, binding = BINDINGS_READBACK_SSBO, set = 0) buffer readbackBuffer
{
  Readback readback;
};

layout(scalar, binding = BINDINGS_RENDERINSTANCES_SSBO, set = 0) buffer renderInstancesBuffer
{
  RenderInstance instances[];
};

layout(scalar, binding = BINDINGS_RENDERMATERIALS_SSBO, set = 0) buffer renderMaterialsBuffer
{
  RenderMaterial materials[];
};

layout(scalar, binding = BINDINGS_GEOMETRIES_SSBO, set = 0) buffer geometryBuffer
{
  Geometry geometries[];
};

layout(binding = BINDINGS_HIZ_TEX)  uniform sampler2D texHizFar;

layout(scalar, binding = BINDINGS_SCENEBUILDING_UBO, set = 0) uniform buildBuffer
{
  SceneBuilding build;  
};

layout(scalar, binding = BINDINGS_SCENEBUILDING_SSBO, set = 0) buffer buildBufferRW
{
  SceneBuilding buildRW;  
};

#if USE_STREAMING
layout(scalar, binding = BINDINGS_STREAMING_UBO, set = 0) uniform streamingBuffer
{
  SceneStreaming streaming;
};
layout(scalar, binding = BINDINGS_STREAMING_SSBO, set = 0) buffer streamingBufferRW
{
  SceneStreaming streamingRW;
};
#endif

////////////////////////////////////////////

layout(local_size_x=INSTANCES_ASSIGN_BLAS_WORKGROUP) in;

////////////////////////////////////////////

void main()
{
  uint instanceID = getGlobalInvocationIndex(gl_GlobalInvocationID);
  
  if (instanceID < build.numRenderInstances)
  {
    InstanceBuildInfo buildInfo = build.instanceBuildInfos.d[instanceID];
    uint buildIndex             = buildInfo.blasBuildIndex;
    
    bool doStats         = true;
    uint64_t blasAddress = 0;
    
  #if USE_BLAS_SHARING    
    // we might reference another instance's blas
    if (buildIndex != BLAS_BUILD_INDEX_LOWDETAIL && (buildIndex & (BLAS_BUILD_INDEX_SHARE_BIT | BLAS_BUILD_INDEX_CACHE_BIT)) != 0)
    {
      uint lookupIndex = buildIndex & ~(BLAS_BUILD_INDEX_SHARE_BIT | BLAS_BUILD_INDEX_CACHE_BIT);
    #if USE_BLAS_CACHING
      if ((buildIndex & BLAS_BUILD_INDEX_CACHE_BIT) != 0)
      {
        blasAddress = geometries[lookupIndex].cachedBlasAddress;
      }
      else
    #endif
      {
        buildIndex = build.instanceBuildInfos.d[lookupIndex].blasBuildIndex;
      }
      // don't add to build stats if we are referencing another instance
      doStats = false;
    }
  #endif
    
    // By default tlasInstances are set to low detail blas,
    // override when applicable.
    
    if (buildIndex != BLAS_BUILD_INDEX_LOWDETAIL)
    {
    #if USE_MEMORY_STATS
      if (doStats)
      {
        atomicAdd(readback.blasActualSizes, uint64_t(build.blasBuildSizes.d[buildIndex]));
      }
    #endif
      
      uint64_t assignAddr =
      #if USE_BLAS_CACHING
        blasAddress != 0 ? blasAddress :
      #endif
        build.blasBuildAddresses.d[buildIndex];
      // NV-DXVK: never overwrite with a 0 reference. Remix full-builds the TLAS
      // every frame (MODE_BUILD) and dereferences every instance's BLAS regardless
      // of mask; if the per-frame build produced no address (blasBuildCounter 0
      // this frame), keep the valid pre-set lowDetailBlasAddress from
      // traversal_init/instance_classify_lod instead of writing 0 -> GPU VA=0.
      if (assignAddr != 0)
      {
        build.tlasInstances.d[instanceID].blasReference = assignAddr;
      }
    }

    // NV-DXVK: [ZeroRefScan] this is the last Path-A writer of blasReference; flag
    // any instance whose FINAL reference is still 0 (the null the full TLAS build
    // reads as VA=0). Report the first one so the CPU can name it.
    if (build.tlasInstances.d[instanceID].blasReference == 0)
    {
      uint prev = atomicAdd(readback.zeroRefCount, 1);
      if (prev == 0)
      {
        readback.zeroRefInstanceId = instanceID;
        readback.zeroRefGeometryId = buildInfo.geometryID;
        readback.zeroRefBuildIndex = buildInfo.blasBuildIndex;
      }
    }

  }

  // NV-DXVK: [BlasHeadScan] mirror the final reference AND the first 8 bytes
  // at that address. The per-frame cluster BLAS builds retired before this
  // dispatch (barriers), so a nonzero ref with a zero head means the TLAS
  // will reference AS memory nothing built - the traversal VA=0 source.
  // Slots beyond this frame's instance count are zeroed (no stale carryover).
  if (instanceID < 64)
  {
    uint64_t finalRef = instanceID < build.numRenderInstances ?
      build.tlasInstances.d[instanceID].blasReference : uint64_t(0);
    readback.dbgBlasRefs[instanceID] = finalRef;
    readback.dbgBlasHeads[instanceID] = finalRef != 0 ? BlasHeadRef(finalRef).d[0] : uint64_t(0);
  }
  
#if 1
  // stats
  if (instanceID == 0)
  {
    readback.numBlasBuilds = build.blasBuildCounter;
  }
#endif
}