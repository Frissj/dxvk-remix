/*
  RTX Remix glue kernel (P4, authored - not part of the NVIDIA samples).

  NVIDIA's cluster culling kernels (culling.glsl intersectHiz) and the nvhiz
  far-mip builder assume the reversed-Z convention the vk_lod_clusters viewer
  renders with (near = 1, far = 0; glm::perspectiveRH_ZO with swapped planes).
  Remix's primary depth buffer stores the game's post-projection z/w in the
  game's own convention - standard-Z (near = 0, far = 1) for virtually all
  D3D9 titles.

  This pass rewrites Remix's previous-frame primary depth into the cluster
  system's own HiZ source image in reversed-Z, so every NVIDIA kernel
  downstream stays byte-identical. The matching cull matrices get the same
  z' = w - z flip on the host (see lodclusters_remix_render.cpp).
*/

#version 460

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D inDepth;
layout(binding = 1, r32f) uniform writeonly image2D outDepth;

layout(push_constant) uniform PushData
{
  ivec2 resolution;
  // 1 = source is the game's standard direction (near = 0, far = 1) and gets
  //     flipped to reversed-Z; 0 = source is already reversed-Z, copy through
  uint flipDepth;
}
push;

void main()
{
  ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
  if(coord.x >= push.resolution.x || coord.y >= push.resolution.y)
  {
    return;
  }

  float depth = texelFetch(inDepth, coord, 0).r;

  // invalid values map to the far plane so unwritten regions never occlude
  if(isnan(depth))
  {
    depth = push.flipDepth != 0 ? 1.0 : 0.0;
  }
  depth = clamp(depth, 0.0, 1.0);

  imageStore(outDepth, coord, vec4(push.flipDepth != 0 ? 1.0 - depth : depth, 0, 0, 0));
}
