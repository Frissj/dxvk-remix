/*
  RTX Remix glue kernel (P4c, authored - not part of the NVIDIA samples).

  RIGID-CAPTURE PROMOTION (plan 7.7): treats the game's vertex shader as a
  black box and recovers, per instance per frame, the affine map M that
  carries the CPU input-space snapshot onto the GPU vertex-capture output.
  Low residual => the mesh is (this frame) a rigid transform of its input
  data => the input-space Path A LOD clusters render it correctly with
  worldMatrix = M, which this kernel patches directly into the frame's
  shaderio::RenderInstance / VkAccelerationStructureInstanceKHR arrays
  between their upload and the first consuming kernel.

  The closed-form solve uses a CPU-precomputed centered Gram pseudoinverse
  (see plan 7.7 spec): rows [A_r | t_r] = Ginv * b_r with
  b_r = sum(refH * cap_r), refH = (refCentered, 1); decentered translation
  t' = t - A*centroid. Residual is checked on a disjoint validation sample
  set; MODE_GATE additionally sweeps EVERY vertex (a mostly-rigid mesh with
  a VS-animated patch must not promote - risk R20).

  Descriptor-free: all inputs via push constants + buffer device addresses.
*/

#version 460

#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 64) in;

#define PROMO_MODE_SOLVE 0
#define PROMO_MODE_GATE  1

#define PROMO_FLAG_RIGID   1u
#define PROMO_FLAG_DEMOTED 4u
#define PROMO_FLAG_SKIPPED 8u    // diagnostic: this slot took the re-solve skip
#define PROMO_FLAG_SOLVED  16u   // this slot has been solved at least once (has a valid retained M)
// promo state slot capacity (mirror of ClusterRenderSystem::kPromotionSlotCapacity)
// - a defensive in-shader bound so a bad stateSlot can never scribble the promo
// buffers (turns a would-be device-lost into a silently dropped entry)
#define PROMO_SLOT_CAPACITY 8192u

#define PROMO_SOLVE_SAMPLES      64
#define PROMO_VALIDATION_SAMPLES 32
// re-solve skip: samples thread 0 tests the cached M against before deciding an
// instance is static this frame (rigid motion moves all vertices, so a handful
// of spread samples catch it; subtle deformation is caught by MODE_GATE).
#define PROMO_CHECK_SAMPLES      8

// ---- data layouts (mirrored by lodclusters_remix.h / the provider's
//      precompute - keep in exact sync with the plan 7.7 spec) ----

struct PromoSample
{
  uint  index;      // vertex index into the capture buffer
  float refX;       // input-space position, CENTERED (p - centroid)
  float refY;
  float refZ;
};

layout(buffer_reference, buffer_reference_align = 4, scalar) buffer ProbeBlob
{
  uint  sampleCount;      // <= PROMO_SOLVE_SAMPLES
  uint  validationCount;  // <= PROMO_VALIDATION_SAMPLES
  uint  vertexCount;      // full-mesh gate range
  uint  _pad0;
  vec3  centroidPos;
  float radius;           // residuals are relative to this
  float gInv[16];         // row-major 4x4 Gram pseudoinverse (doubles on CPU)
  PromoSample samples[];  // [sampleCount] solve + [validationCount] validation
                          // + full ref positions appended as PromoSample
                          // {index = i} for the gate sweep
};

struct PromoEntry
{
  uint64_t probeVa;
  uint64_t captureVa;
  uint     captureStrideBytes;
  uint     stateSlot;
  uint     patchSlot;  // 0xFFFFFFFF = probe-only (no patch)
  uint     mode;
  uint     vertexCount;  // gate dispatch sizing (mode 1; kernel bounds on probe)
  uint     pad0;
  uint64_t prevCaptureVa;  // previous-frame capture; 0 = none. cold-promote prevM seed (see MODE_SOLVE)
};

layout(buffer_reference, buffer_reference_align = 8, scalar) buffer PromoEntries
{
  PromoEntry entries[];
};

// SoA promo state: matrices (96 B / slot - M then prevM, row-major 3x4 each)
layout(buffer_reference, buffer_reference_align = 4, scalar) buffer PromoMatrices
{
  float m[];  // slot * 24 + [0,12) = M rows, [12,24) = prevM rows
};

// status (56 B / slot) - the part read back to the CPU. MUST match Impl::kPromoStatusStride
// and readPromotionStates()/PromotionStateView on the C++ side.
struct PromoStatus
{
  float residualRel;
  uint  gateResidualBits;  // ordered-uint float (atomicMax)
  uint  rigidStreak;
  uint  flags;
  uint  lastFrame;
  float _pad0;   // [MotionProbe] per-frame transform translation delta (world units) - CENTROID only
  uint  _pad1;
  uint  _pad2;   // [SmearProbe] floatBitsToUint(max over solve samples of |(M-prevM)*vertex|) - per-VERTEX
                 // manufactured motion. Catches a rotation-only prevM lineage break (centroid ~still, extremities fling).
  // [PromoDump] raw solved-transform translation columns (world units) for lag/smear diagnosis:
  // curT = where Path A places this instance's origin this frame; prevT = last frame's (what the
  // motion vector reprojects from). CPU checks prevT_this == curT_last for prevM lineage.
  float curTx;  float curTy;  float curTz;
  float prevTx; float prevTy; float prevTz;
  // [PromoGap] where this instance's centroid is actually PLACED in world (M * centroid) - i.e.
  // where Path A draws it. CPU compares this to the instance's live bbox centroid; a large gap =
  // the object is drawn far from where it should be (wrong transform for this slot).
  float placedX; float placedY; float placedZ;
  // [PromoGap] the RELIABLE reference: mean of this frame's actual reconstructed capture samples
  // (where the geometry truly is in world). If placed != capture, the solved M does not put the
  // object where its own capture is - a genuine misplacement independent of any CPU bbox.
  float capX; float capY; float capZ;
  // [ConditionProbe] isotropy of the SOLVE sample cloud = det(cov)/(trace/3)^3, in [0,1]. ~1 = samples
  // fill 3D (rotation fully constrained by the fit). ~0 = planar/collinear/symmetric samples -> the
  // affine solve's ROTATION is UNDERDETERMINED: it fits every sample yet the rotation DOF is free, so
  // it lands on an arbitrary valid rotation that jumps frame-to-frame = the [SmearProbe] fling. -1 = skip.
  float sampleIso;
  // [SmearPix] written by the GBUFFER pass (surface_interaction promoted-hit block), NOT this kernel:
  // float bits of the max on-screen UNCANCELLED screen-space motion residual (in pixels) any pixel of
  // this slot's instance produced this frame - i.e. the smear itself, measured where it happens, with
  // the live cur/prev cameras. This kernel must PRESERVE it (whole-struct writes carry it through);
  // recordPromotion zeroes it after the readback copy each frame.
  uint smearPixBits;
};

layout(buffer_reference, buffer_reference_align = 4, scalar) buffer PromoStatuses
{
  PromoStatus s[];
};

layout(buffer_reference, buffer_reference_align = 4, scalar) buffer RawFloats
{
  float f[];
};

layout(buffer_reference, buffer_reference_align = 4, scalar) buffer RawUints
{
  uint u[];
};

layout(push_constant, scalar) uniform PushData
{
  uint64_t entriesVa;
  uint64_t matricesVa;
  uint64_t statusVa;
  uint64_t renderInstancesVa;
  uint64_t tlasInstancesVa;
  uint     entryCount;
  uint     frameId;
  uint     riStrideBytes;          // sizeof(shaderio::RenderInstance)
  uint     riWorldMatrixOffset;    // glm::mat4x3, column-major, 12 floats
  uint     riWorldMatrixIOffset;   // glm::mat4x3, column-major, 12 floats
  uint     riFlipWindingOffset;    // dword holding flipWinding|twoSided|multiMaterial|opaqueStatus bytes
  float    residualEpsilon;        // relative to probe radius
  uint     gateEntryIndex;         // MODE_GATE: which entry this dispatch runs
  uint     allowResolveSkip;       // 0 = every promoted slot full-solves each frame (see below)
  uint     gapMaxFrames;           // max solve-frame gap for which the retained prevM is still trusted
  float    rotStabilizeIso;        // [RotStabilize] anchor rotation to prevM when sampleIso < this; 0 = off
  float    teleportClampRadii;     // [TeleportClamp] zero the MV when per-frame motion > this x object radius; 0 = off
}
push;

// ---- shared reduction storage ----
shared float s_b[64][12];      // per-thread partial b vectors (3 rows x 4)
shared float s_dev[64];        // validation deviations
shared float s_M[12];          // solved rows [A|t'] (row-major 3x4)
shared bool  s_rigid;
shared bool  s_skip;           // re-solve skip verdict (thread 0 -> all)

vec3 loadCapture(uint64_t captureVa, uint strideBytes, uint index)
{
  RawFloats capture = RawFloats(captureVa + uint64_t(strideBytes) * uint64_t(index));
  return vec3(capture.f[0], capture.f[1], capture.f[2]);
}

void main()
{
  const uint threadId = gl_LocalInvocationID.x;

  PromoEntries entriesBuf = PromoEntries(push.entriesVa);
  const uint entryIndex = (push.gateEntryIndex != 0xFFFFFFFFu) ? push.gateEntryIndex : gl_WorkGroupID.x;
  if(entryIndex >= push.entryCount)
  {
    return;
  }
  const PromoEntry entry = entriesBuf.entries[entryIndex];

  // the batched solve dispatch covers every entry by group index - gate
  // entries run through their own per-entry dispatches (gateEntryIndex set)
  if(push.gateEntryIndex == 0xFFFFFFFFu && entry.mode != PROMO_MODE_SOLVE)
  {
    return;
  }

  // defensive: a bad stateSlot would index the promo matrices/status buffers
  // out of bounds and can device-lost. Drop the whole (uniform) workgroup - the
  // stateSlot is per-entry uniform, so every thread returns together (no barrier
  // reached, no divergence). probeVa==0 means the probe was freed (rejected) -
  // also nothing safe to do.
  if(entry.stateSlot >= PROMO_SLOT_CAPACITY || entry.probeVa == 0ul)
  {
    return;
  }

  ProbeBlob     probe    = ProbeBlob(entry.probeVa);
  PromoStatuses statuses = PromoStatuses(push.statusVa);

  // ======================================================================
  // MODE_GATE: full-mesh residual sweep with the already-solved M (grid of
  // groups over vertexCount; probe stores the full ref positions after the
  // solve + validation samples)
  // ======================================================================
  if(entry.mode == PROMO_MODE_GATE)
  {
    PromoMatrices matrices = PromoMatrices(push.matricesVa);
    const uint mBase = entry.stateSlot * 24;

    // rows of M (last good solve)
    vec4 r0 = vec4(matrices.m[mBase + 0], matrices.m[mBase + 1], matrices.m[mBase + 2], matrices.m[mBase + 3]);
    vec4 r1 = vec4(matrices.m[mBase + 4], matrices.m[mBase + 5], matrices.m[mBase + 6], matrices.m[mBase + 7]);
    vec4 r2 = vec4(matrices.m[mBase + 8], matrices.m[mBase + 9], matrices.m[mBase + 10], matrices.m[mBase + 11]);

    const uint fullBase = probe.sampleCount + probe.validationCount;
    const uint vertex   = gl_WorkGroupID.x * 64u + threadId;
    if(vertex >= probe.vertexCount)
    {
      return;
    }

    // full ref positions are stored CENTERED like the samples, index = vertex.
    // The matrices buffer holds the DECENTERED M (it maps ORIGINAL input-space
    // positions - see the decenter step in MODE_SOLVE), so the centroid must be
    // folded back in before comparing. Applying decentered M directly to
    // centered positions offsets every fitted point by -A*centroid, which
    // failed every gate on meshes away from the origin (residual ~ |A*c|/
    // radius; observed 0.4-96 on 100% of gates, 2026-07-04 run). Fold the
    // centroid into the translation (A*pc + (A*c + t')) instead of adding it
    // to the position, preserving the centered offset's fp32 precision (R19).
    const PromoSample refSample = probe.samples[fullBase + vertex];
    const vec3 pc   = vec3(refSample.refX, refSample.refY, refSample.refZ);
    const vec3 cGate = probe.centroidPos;
    const vec3 cap  = loadCapture(entry.captureVa, entry.captureStrideBytes, refSample.index);

    const vec3 tCentered = vec3(dot(r0.xyz, cGate) + r0.w,
                                dot(r1.xyz, cGate) + r1.w,
                                dot(r2.xyz, cGate) + r2.w);
    const vec3 fitted = vec3(dot(r0.xyz, pc), dot(r1.xyz, pc), dot(r2.xyz, pc)) + tCentered;
    const float devRel = length(fitted - cap) / max(probe.radius, 1e-6);

    atomicMax(statuses.s[entry.stateSlot].gateResidualBits, floatBitsToUint(devRel));
    return;
  }

  // ======================================================================
  // MODE_SOLVE: one 64-thread group per entry
  // ======================================================================

  // ---- P4c RE-SOLVE SKIP: if last frame's cached M still fits this frame's
  //      capture (the instance is static), re-patch from cache and skip the
  //      full solve. Most promoted geometry sits still, so this turns a
  //      96-sample solve + pseudoinverse into ~8 sample reads.
  //
  //      SAFETY (learned the hard way - two GPU-fault builds):
  //        * ONLY thread 0 reads the status/matrices and decides; the barrier
  //          below is UNCONDITIONAL and the return is on a shared flag, so no
  //          status-dependent divergent barrier can hang the workgroup.
  //        * patch is INLINED, not a helper function - an extracted function
  //          taking float[12] by value and doing buffer_reference writes was in
  //          both crashing builds and is a known SPIR-V codegen landmine.
  //        * only PROMOTED instances (patchSlot valid) skip; candidate/probe
  //          entries always full-solve so rigidity tracking stays honest.
  //        * cached M is NaN/Inf-guarded before it can reach the TLAS.
  if(threadId == 0)
  {
    s_skip = false;
    const PromoStatus stChk = statuses.s[entry.stateSlot];
    // The skip reuses last frame's cached M when it still REPRODUCES this frame's
    // capture within residualEpsilon. That is a rigidity test, not a stillness test:
    // this game's promoted geometry is vertex-captured and reconstructed CAMERA-RELATIVE
    // (inv(D3DTS)), so when the camera moves every capture drifts a little each frame.
    // A drift under the epsilon band still passes the fit check, so the skip FREEZES M
    // and forces prevM = M (zero motion) - the promoted object then trails the camera and
    // its motion vector dies (smear), snapping back only when motion stops. push.allowResolveSkip
    // gates it OFF by default so every promoted slot full-solves each frame (placement tracks
    // the capture, prevM = last frame's M gives the correct motion vector). Re-enable only to
    // A/B the lag or measure the skip's perf saving.
    const bool haveCachedM = push.allowResolveSkip != 0u
                          && stChk.lastFrame != 0u
                          && (stChk.lastFrame + 1u == push.frameId)
                          && (stChk.flags & PROMO_FLAG_RIGID) != 0u
                          && entry.patchSlot != 0xFFFFFFFFu;
    if(haveCachedM)
    {
      PromoMatrices matrices = PromoMatrices(push.matricesVa);
      const uint mBase = entry.stateSlot * 24;

      float P[12];
      bool finite = true;
      for(uint k = 0; k < 12; k++)
      {
        P[k] = matrices.m[mBase + k];
        finite = finite && !isinf(P[k]) && !isnan(P[k]);
      }

      // fold centroid into the translation (matrices hold DECENTERED M, samples
      // are CENTERED) - same correction MODE_GATE needs, else off-origin meshes
      // never match and the skip never fires
      const vec3 cChk = probe.centroidPos;
      const vec3 tC = vec3(P[0]*cChk.x + P[1]*cChk.y + P[2]*cChk.z + P[3],
                           P[4]*cChk.x + P[5]*cChk.y + P[6]*cChk.z + P[7],
                           P[8]*cChk.x + P[9]*cChk.y + P[10]*cChk.z + P[11]);

      const uint checkN = min(probe.validationCount, uint(PROMO_CHECK_SAMPLES));
      float maxDev = 0.0;
      vec3 capCenChk = vec3(0.0);  // [PromoGap] mean capture over validation samples
      for(uint i = 0; i < checkN; i++)
      {
        const PromoSample smp = probe.samples[probe.sampleCount + i];
        const vec3 pc  = vec3(smp.refX, smp.refY, smp.refZ);
        const vec3 cap = loadCapture(entry.captureVa, entry.captureStrideBytes, smp.index);
        capCenChk += cap;
        const vec3 fit = vec3(P[0]*pc.x + P[1]*pc.y + P[2]*pc.z,
                              P[4]*pc.x + P[5]*pc.y + P[6]*pc.z,
                              P[8]*pc.x + P[9]*pc.y + P[10]*pc.z) + tC;
        maxDev = max(maxDev, length(fit - cap));
      }
      capCenChk /= float(max(1u, checkN));

      // PERF skip: if last frame's cached M still reproduces this frame's capture within
      // the rigidity bound, the instance is effectively static - reuse the cached M and
      // skip the full 96-sample solve. Gated on residualEpsilon (does the cached M still
      // fit), the bound this skip used before the smear work. The promotion motion-vector
      // smear that once justified a separate tighter threshold here is fixed properly in
      // surface_interaction (a promoted hit's previous position now uses the GPU-solved
      // prevM instead of the CPU matrix), so no decoupled motion epsilon is needed. When
      // this fires the cached M still fits, so placement doesn't visibly lag and the
      // zero motion it reports (prevM = M) is correct for a static instance.
      if(finite && checkN > 0u && (maxDev / max(probe.radius, 1e-6)) <= push.residualEpsilon)
      {
        // static this frame: prevM = M (zero motion), keep the streak, patch
        for(uint k = 0; k < 12; k++)
        {
          matrices.m[mBase + 12 + k] = P[k];
        }
        PromoStatus st = stChk;
        st.rigidStreak = st.rigidStreak + 1u;
        st.lastFrame   = push.frameId;
        st.flags       = (st.flags & ~PROMO_FLAG_DEMOTED) | PROMO_FLAG_RIGID | PROMO_FLAG_SKIPPED;
        st._pad0       = 0.0;  // [MotionProbe] static-skip => prevM==M => zero motion by construction
        st._pad2       = 0u;   // [SmearProbe] prevM==M => per-vertex motion is 0 by construction too
        st.sampleIso   = -1.0; // [ConditionProbe] not computed on the static-skip path
        // [PromoDump] skip => curT == prevT == cached-M translation (decentered rows P at 3/7/11)
        st.curTx = P[3];  st.curTy = P[7];  st.curTz = P[11];
        st.prevTx = P[3]; st.prevTy = P[7]; st.prevTz = P[11];
        // [PromoGap] placed centroid = cached decentered P applied to the ref centroid
        st.placedX = P[0]*cChk.x + P[1]*cChk.y + P[2]*cChk.z + P[3];
        st.placedY = P[4]*cChk.x + P[5]*cChk.y + P[6]*cChk.z + P[7];
        st.placedZ = P[8]*cChk.x + P[9]*cChk.y + P[10]*cChk.z + P[11];
        st.capX = capCenChk.x; st.capY = capCenChk.y; st.capZ = capCenChk.z;  // [PromoGap]
        statuses.s[entry.stateSlot] = st;

        // --- INLINE patch (mirrors the full-solve patch at the end of main) ---
        RawFloats wm = RawFloats(push.renderInstancesVa + uint64_t(entry.patchSlot) * uint64_t(push.riStrideBytes)
                                 + uint64_t(push.riWorldMatrixOffset));
        wm.f[0] = P[0]; wm.f[1] = P[4]; wm.f[2] = P[8];
        wm.f[3] = P[1]; wm.f[4] = P[5]; wm.f[5] = P[9];
        wm.f[6] = P[2]; wm.f[7] = P[6]; wm.f[8] = P[10];
        wm.f[9] = P[3]; wm.f[10] = P[7]; wm.f[11] = P[11];

        const float det = P[0] * (P[5] * P[10] - P[6] * P[9])
                        - P[1] * (P[4] * P[10] - P[6] * P[8])
                        + P[2] * (P[4] * P[9] - P[5] * P[8]);
        const float invDet = abs(det) > 1e-20 ? 1.0 / det : 0.0;
        float I[9];
        I[0] = (P[5]*P[10]-P[6]*P[9])*invDet; I[1] = (P[2]*P[9]-P[1]*P[10])*invDet; I[2] = (P[1]*P[6]-P[2]*P[5])*invDet;
        I[3] = (P[6]*P[8]-P[4]*P[10])*invDet; I[4] = (P[0]*P[10]-P[2]*P[8])*invDet; I[5] = (P[2]*P[4]-P[0]*P[6])*invDet;
        I[6] = (P[4]*P[9]-P[5]*P[8])*invDet;  I[7] = (P[1]*P[8]-P[0]*P[9])*invDet;  I[8] = (P[0]*P[5]-P[1]*P[4])*invDet;
        const vec3 it = -vec3(I[0]*P[3]+I[1]*P[7]+I[2]*P[11],
                              I[3]*P[3]+I[4]*P[7]+I[5]*P[11],
                              I[6]*P[3]+I[7]*P[7]+I[8]*P[11]);
        RawFloats wmi = RawFloats(push.renderInstancesVa + uint64_t(entry.patchSlot) * uint64_t(push.riStrideBytes)
                                  + uint64_t(push.riWorldMatrixIOffset));
        wmi.f[0] = I[0]; wmi.f[1] = I[3]; wmi.f[2] = I[6];
        wmi.f[3] = I[1]; wmi.f[4] = I[4]; wmi.f[5] = I[7];
        wmi.f[6] = I[2]; wmi.f[7] = I[5]; wmi.f[8] = I[8];
        wmi.f[9] = it.x; wmi.f[10] = it.y; wmi.f[11] = it.z;

        const bool mirrored = det < 0.0;
        {
          RawUints riPacked = RawUints(push.renderInstancesVa + uint64_t(entry.patchSlot) * uint64_t(push.riStrideBytes)
                                       + uint64_t(push.riFlipWindingOffset));
          uint packed = riPacked.u[0];
          const bool twoSided = ((packed >> 8) & 0xFFu) != 0u;
          packed = (packed & ~0xFFu) | ((!twoSided && mirrored) ? 1u : 0u);
          riPacked.u[0] = packed;
        }
        if(mirrored)
        {
          RawUints tlasFlags = RawUints(push.tlasInstancesVa + uint64_t(entry.patchSlot) * 64ul + 52ul);
          tlasFlags.u[0] ^= (2u << 24);
        }
        RawFloats tlas = RawFloats(push.tlasInstancesVa + uint64_t(entry.patchSlot) * 64ul);
        for(uint k = 0; k < 12; k++)
        {
          tlas.f[k] = P[k];
        }

        s_skip = true;
      }
    }
  }

  barrier();          // UNCONDITIONAL - every thread hits this exactly once
  if(s_skip)          // uniform: shared, written by thread 0 before the barrier
  {
    return;
  }

  // ---- partial b vectors: b_r = sum(refH * cap_r) over the solve samples ----
  for(uint k = 0; k < 12; k++)
  {
    s_b[threadId][k] = 0.0;
  }

  if(threadId < probe.sampleCount)
  {
    const PromoSample smp = probe.samples[threadId];
    const vec4 refH = vec4(smp.refX, smp.refY, smp.refZ, 1.0);
    const vec3 cap  = loadCapture(entry.captureVa, entry.captureStrideBytes, smp.index);

    for(uint r = 0; r < 3; r++)
    {
      const float capR = cap[r];
      s_b[threadId][r * 4 + 0] = refH.x * capR;
      s_b[threadId][r * 4 + 1] = refH.y * capR;
      s_b[threadId][r * 4 + 2] = refH.z * capR;
      s_b[threadId][r * 4 + 3] = refH.w * capR;
    }
  }

  barrier();

  // ---- thread 0: reduce, solve rows via the precomputed pseudoinverse ----
  if(threadId == 0)
  {
    float b[12];
    for(uint k = 0; k < 12; k++)
    {
      float acc = 0.0;
      for(uint t = 0; t < 64; t++)
      {
        acc += s_b[t][k];
      }
      b[k] = acc;
    }

    // row r of [A|t]: (Ginv * b_r) - Ginv is row-major 4x4
    for(uint r = 0; r < 3; r++)
    {
      for(uint c = 0; c < 4; c++)
      {
        s_M[r * 4 + c] = probe.gInv[c * 4 + 0] * b[r * 4 + 0]
                       + probe.gInv[c * 4 + 1] * b[r * 4 + 1]
                       + probe.gInv[c * 4 + 2] * b[r * 4 + 2]
                       + probe.gInv[c * 4 + 3] * b[r * 4 + 3];
      }
    }
  }

  barrier();

  // ---- validation residual on the disjoint sample set ----
  s_dev[threadId] = 0.0;
  if(threadId < probe.validationCount)
  {
    const PromoSample smp = probe.samples[probe.sampleCount + threadId];
    const vec4 refH = vec4(smp.refX, smp.refY, smp.refZ, 1.0);
    const vec3 cap  = loadCapture(entry.captureVa, entry.captureStrideBytes, smp.index);

    const vec3 fitted = vec3(dot(vec4(s_M[0], s_M[1], s_M[2], s_M[3]), refH),
                             dot(vec4(s_M[4], s_M[5], s_M[6], s_M[7]), refH),
                             dot(vec4(s_M[8], s_M[9], s_M[10], s_M[11]), refH));
    s_dev[threadId] = length(fitted - cap);
  }

  barrier();

  if(threadId != 0)
  {
    return;
  }

  float maxDev = 0.0;
  for(uint t = 0; t < PROMO_VALIDATION_SAMPLES; t++)
  {
    maxDev = max(maxDev, s_dev[t]);
  }
  const float residualRel = maxDev / max(probe.radius, 1e-6);
  const bool  rigid       = residualRel <= push.residualEpsilon;

  // ---- decenter: the solve ran on (p - centroid); world translation is
  //      t' = t - A * centroid ----
  const vec3 c = probe.centroidPos;
  float M[12];
  for(uint k = 0; k < 12; k++)
  {
    M[k] = s_M[k];
  }
  M[3]  -= M[0] * c.x + M[1] * c.y + M[2] * c.z;
  M[7]  -= M[4] * c.x + M[5] * c.y + M[6] * c.z;
  M[11] -= M[8] * c.x + M[9] * c.y + M[10] * c.z;

  // ---- state update ----
  PromoMatrices matrices = PromoMatrices(push.matricesVa);
  const uint mBase = entry.stateSlot * 24;

  PromoStatus status = statuses.s[entry.stateSlot];
  const bool contiguous = (status.lastFrame + 1u == push.frameId);
  const bool everSolved = (status.flags & PROMO_FLAG_SOLVED) != 0u;

  // [ConditionProbe] isotropy of the solve sample cloud = det(cov)/(trace/3)^3 in [0,1]. ~1 = samples
  // fill 3D (rotation constrained), ~0 = planar/collinear/symmetric (rotation UNDERDETERMINED). Computed
  // here so [RotStabilize] below can use it; also read back for the [SmearProbe] correlation log.
  float sampleIso;
  {
    float cxx = 0.0, cyy = 0.0, czz = 0.0, cxy = 0.0, cxz = 0.0, cyz = 0.0;
    for(uint t = 0; t < probe.sampleCount; t++)
    {
      const PromoSample smp = probe.samples[t];
      const vec3 p = vec3(smp.refX, smp.refY, smp.refZ);  // already centered on the centroid
      cxx += p.x * p.x; cyy += p.y * p.y; czz += p.z * p.z;
      cxy += p.x * p.y; cxz += p.x * p.z; cyz += p.y * p.z;
    }
    const float invN = 1.0 / float(max(1u, probe.sampleCount));
    cxx *= invN; cyy *= invN; czz *= invN; cxy *= invN; cxz *= invN; cyz *= invN;
    const float detC = cxx * (cyy * czz - cyz * cyz)
                     - cxy * (cxy * czz - cyz * cxz)
                     + cxz * (cxy * cyz - cyy * cxz);
    const float tr3 = (cxx + cyy + czz) * (1.0 / 3.0);
    sampleIso = clamp(detC / max(1e-12, tr3 * tr3 * tr3), 0.0, 1.0);
  }

  // [RotStabilize] THE underdetermined-rotation fix. When the sample cloud is degenerate (low iso) the
  // solved rotation is free and jumps frame-to-frame, flinging the extremities = the raw smear. If iso is
  // below the threshold AND this slot solved last frame (matrices.m[mBase+0..] still holds last frame's M,
  // not yet overwritten), blend the solved LINEAR part toward last frame's, weighted by degeneracy (full
  // anchor at iso 0, none at iso>=threshold), then RE-PIN the centroid so M*centroid (the well-determined
  // placement) is unchanged. The rotation stops jumping; well-conditioned meshes (iso>=threshold) untouched.
  if(push.rotStabilizeIso > 0.0 && everSolved && contiguous && sampleIso < push.rotStabilizeIso)
  {
    const float w = clamp((push.rotStabilizeIso - sampleIso) / push.rotStabilizeIso, 0.0, 1.0);
    // solved linear part (row-major 3x3 within M)
    const float A0 = M[0], A1 = M[1], A2 = M[2];
    const float A4 = M[4], A5 = M[5], A6 = M[6];
    const float A8 = M[8], A9 = M[9], A10 = M[10];
    // last frame's linear part (retained M, still in place)
    const float P0 = matrices.m[mBase + 0], P1 = matrices.m[mBase + 1], P2 = matrices.m[mBase + 2];
    const float P4 = matrices.m[mBase + 4], P5 = matrices.m[mBase + 5], P6 = matrices.m[mBase + 6];
    const float P8 = matrices.m[mBase + 8], P9 = matrices.m[mBase + 9], P10 = matrices.m[mBase + 10];
    const float B0 = mix(A0, P0, w), B1 = mix(A1, P1, w), B2 = mix(A2, P2, w);
    const float B4 = mix(A4, P4, w), B5 = mix(A5, P5, w), B6 = mix(A6, P6, w);
    const float B8 = mix(A8, P8, w), B9 = mix(A9, P9, w), B10 = mix(A10, P10, w);
    // re-pin the centroid: t += (A_solved - A_blended) * centroid so M*centroid is unchanged
    M[3]  += (A0 - B0) * c.x + (A1 - B1) * c.y + (A2 - B2) * c.z;
    M[7]  += (A4 - B4) * c.x + (A5 - B5) * c.y + (A6 - B6) * c.z;
    M[11] += (A8 - B8) * c.x + (A9 - B9) * c.y + (A10 - B10) * c.z;
    M[0] = B0; M[1] = B1; M[2] = B2;
    M[4] = B4; M[5] = B5; M[6] = B6;
    M[8] = B8; M[9] = B9; M[10] = B10;
  }

  // [ColdPromo] probe (diagnostic): a promoted (patchSlot-valid) slot that was NEVER
  // solved has no previous transform, so prevM = curM below => one frame of ZERO motion.
  // That is a genuine first appearance / disocclusion (no history to reproject - TAA
  // rejects it anyway), which is acceptable. A slot solved before (contiguous OR gapped)
  // now reuses its retained M and is no longer cold. Sticky record; after the fix this
  // should fire only on true first appearances, not the churn/gap waves.
  if(entry.patchSlot != 0xFFFFFFFFu && !everSolved)
  {
    status._pad1 = push.frameId;
  }

  // prevM for motion continuity. Reuse the slot's RETAINED M (mBase+0) whenever it has
  // EVER been solved: the contiguous case gives last frame's M, and a GAPPED slot (a
  // promoted instance that dropped a frame, or whose BlasEntry was rebuilt by a [BlasWave]
  // and whose warm slot the CPU recovered by instance id) gives the pre-gap M - the right
  // previous transform for a rigid instance, and far better than seeding prevM = curM
  // (zero motion => one frame of the reconstruction wobble => the promotion smear).
  //
  // COLD PROMOTION SEED: a slot NEVER solved (a Path B->A flip whose fresh per-instance slot
  // has no GPU history) has no retained M. Seeding prevM = curM there is the [ColdPromo]
  // zero-motion pop the denoiser reprojects wrong AT the promotion frame. When the instance's
  // PREVIOUS-frame capture is available (entry.prevCaptureVa != 0 - it rendered Path B last
  // frame, so historyBuffer[1] holds its previous reconstructed positions) seed prevM to
  // reproduce last frame's world position instead: keep this frame's fitted A (rotation/scale)
  // and set the translation so prevM maps the ref centroid onto the MEAN of the PREVIOUS
  // capture. Motion is then (prevM - M)*obj = mean(prevCap) - mean(curCap) for every vertex =
  // the object's true inter-frame drift (rigid, translation-dominant), continuous with the
  // Path B motion vector it had last frame. Only a genuine first appearance (no prev capture)
  // still falls back to prevM = curM, which is correct - TAA rejects a real disocclusion.
  const bool coldSeed = (entry.patchSlot != 0xFFFFFFFFu) && !everSolved && (entry.prevCaptureVa != 0ul);
  vec3 tPrevSeed = vec3(0.0);
  if(coldSeed)
  {
    vec3 capPrevMean = vec3(0.0);
    for(uint t = 0; t < probe.sampleCount; t++)
    {
      capPrevMean += loadCapture(entry.prevCaptureVa, entry.captureStrideBytes, probe.samples[t].index);
    }
    capPrevMean /= float(max(1u, probe.sampleCount));
    // M is decentered (maps original ref -> world) so M * centroid == mean(curCapture);
    // prevM shares A with M, translation = mean(prevCapture) - A * centroid.
    tPrevSeed = capPrevMean - vec3(M[0]*c.x + M[1]*c.y + M[2]*c.z,
                                   M[4]*c.x + M[5]*c.y + M[6]*c.z,
                                   M[8]*c.x + M[9]*c.y + M[10]*c.z);
  }
  // GAP-STALE guard (the moving-cinematic smear fix). The retained M is only LAST frame's
  // transform when the slot solved on the previous frame. A promoted slot that left Path A (went
  // off-screen or flipped to Path B) and re-renders N frames later re-solves NON-contiguously, and
  // its retained M is from N frames ago - reusing it as prevM makes the motion vector N frames of
  // camera drift in ONE frame ([ChurnDiag] worstGap 29-77f, [SolveCadence] delta 1 => the shader
  // sees these gaps). A reappearing/disoccluded object has no valid N-frames-ago on-screen position,
  // so trust the retained M only for gaps <= gapMaxFrames (contiguous, or the original single
  // dropped-frame case); beyond that fall back to zero motion, whose reprojection error is bounded
  // by the object's own screen extent instead of the unbounded stale-M spike. gapMaxFrames huge =
  // old behavior (for A/B).
  const uint solveGap = push.frameId - status.lastFrame;   // 1 = solved last frame (contiguous)
  const bool useRetained = everSolved && (solveGap <= push.gapMaxFrames);
  for(uint k = 0; k < 12; k++)
  {
    float prev;
    if(useRetained)
    {
      prev = matrices.m[mBase + k];        // retained M is recent enough to be last frame's
    }
    else if(coldSeed)
    {
      // same A rows as M; only the translation column (k = 3,7,11) becomes tPrevSeed
      prev = (k == 3) ? tPrevSeed.x : ((k == 7) ? tPrevSeed.y : ((k == 11) ? tPrevSeed.z : M[k]));
    }
    else
    {
      prev = M[k];                         // first appearance OR stale-gap reappearance -> zero motion
    }
    matrices.m[mBase + 12 + k] = prev;
    matrices.m[mBase + k]      = M[k];
  }

  status.residualRel = residualRel;
  status.rigidStreak = rigid ? (contiguous ? status.rigidStreak + 1u : 1u) : 0u;
  status.lastFrame   = push.frameId;
  // clear SKIPPED too - this frame did the full solve (diagnostic counter)
  status.flags       = (status.flags & ~(PROMO_FLAG_RIGID | PROMO_FLAG_DEMOTED | PROMO_FLAG_SKIPPED))
                     | (rigid ? PROMO_FLAG_RIGID : PROMO_FLAG_DEMOTED) | PROMO_FLAG_SOLVED;
  // [MotionProbe] RAW per-frame transform translation delta (world units) = exactly the
  // motion the render applies to this promoted instance via M/prevM. Nonzero on a
  // camera-still frame => the solve is manufacturing motion; matches parallax => source ok.
  {
    const vec3 curT  = vec3(M[3], M[7], M[11]);
    const vec3 prevT = vec3(matrices.m[mBase + 12 + 3], matrices.m[mBase + 12 + 7], matrices.m[mBase + 12 + 11]);
    status._pad0 = length(curT - prevT);
    status.curTx = curT.x;   status.curTy = curT.y;   status.curTz = curT.z;    // [PromoDump]
    status.prevTx = prevT.x; status.prevTy = prevT.y; status.prevTz = prevT.z;
    // [PromoGap] placed centroid = decentered M applied to the ref centroid = world position of
    // the object's center as drawn on Path A.
    status.placedX = M[0]*c.x + M[1]*c.y + M[2]*c.z + M[3];
    status.placedY = M[4]*c.x + M[5]*c.y + M[6]*c.z + M[7];
    status.placedZ = M[8]*c.x + M[9]*c.y + M[10]*c.z + M[11];
    // [PromoGap] reliable reference: mean of the actual capture samples (thread 0 only).
    vec3 capCen = vec3(0.0);
    const uint capN = max(1u, probe.sampleCount);
    for(uint t = 0; t < probe.sampleCount; t++) {
      capCen += loadCapture(entry.captureVa, entry.captureStrideBytes, probe.samples[t].index);
    }
    capCen /= float(capN);
    status.capX = capCen.x; status.capY = capCen.y; status.capZ = capCen.z;
  }
  // [SmearProbe] per-VERTEX manufactured motion = max over the solve samples of |(M - prevM) * vertex|.
  // motionDelta above is the CENTROID translation and can read ~0 while M and prevM differ in ROTATION,
  // which leaves the centroid put but flings the mesh extremities - that per-vertex fling is exactly the
  // motion vector the promoted hit hands DLSS, i.e. the smear. Uses the SAME live decentered M (local)
  // and prevM (matrices.m[mBase+12+k], just written) the render's surface_interaction reads. Samples are
  // CENTERED, M/prevM are decentered (map ORIGINAL input positions), so fold the centroid back in.
  {
    float maxVertMotion = 0.0;
    for(uint t = 0; t < probe.sampleCount; t++)
    {
      const PromoSample smp = probe.samples[t];
      const vec4 rp = vec4(smp.refX + c.x, smp.refY + c.y, smp.refZ + c.z, 1.0);
      const vec3 wCur = vec3(dot(vec4(M[0], M[1], M[2], M[3]), rp),
                             dot(vec4(M[4], M[5], M[6], M[7]), rp),
                             dot(vec4(M[8], M[9], M[10], M[11]), rp));
      const vec3 wPrev = vec3(dot(vec4(matrices.m[mBase + 12 + 0], matrices.m[mBase + 12 + 1], matrices.m[mBase + 12 + 2], matrices.m[mBase + 12 + 3]), rp),
                             dot(vec4(matrices.m[mBase + 12 + 4], matrices.m[mBase + 12 + 5], matrices.m[mBase + 12 + 6], matrices.m[mBase + 12 + 7]), rp),
                             dot(vec4(matrices.m[mBase + 12 + 8], matrices.m[mBase + 12 + 9], matrices.m[mBase + 12 + 10], matrices.m[mBase + 12 + 11]), rp));
      maxVertMotion = max(maxVertMotion, length(wCur - wPrev));
    }
    status._pad2 = floatBitsToUint(maxVertMotion);

    // [TeleportClamp] THE smear fix (LEGO Batman cinemtic root cause, 2026-07-14). These games animate
    // cinematic props in DISCRETE STEPS; at streaming framerates one step is 10-34 world units. The
    // promoted MV honestly reports that jump and DLSS drags a full step of shading across the screen =
    // the raw smear. (Path B looked clean only because its CPU prev==cur matrices report ZERO motion,
    // so DLSS treats the step as a disocclusion and rejects history.) When the per-vertex per-frame
    // motion exceeds the object's OWN radius x threshold - motion no temporal accumulator can reuse -
    // report zero motion instead (prevM = M, proper disocclusion semantics). Scale-free (radius-
    // relative), game-agnostic, placement (M) untouched: the object still renders at its exact new
    // pose, only the useless teleport-scale motion vector is dropped.
    if(push.teleportClampRadii > 0.0 && maxVertMotion > push.teleportClampRadii * max(probe.radius, 1e-6))
    {
      for(uint k = 0; k < 12; k++)
      {
        matrices.m[mBase + 12 + k] = M[k];
      }
      status._pad0 = 0.0;
      status.prevTx = status.curTx; status.prevTy = status.curTy; status.prevTz = status.curTz;
    }
  }
  // [ConditionProbe] readback the isotropy computed above (drives [RotStabilize] + the [SmearProbe] log).
  status.sampleIso = sampleIso;
  statuses.s[entry.stateSlot] = status;

  // ---- patch a promoted instance's slot: ALWAYS write when assigned - a
  //      non-rigid frame keeps the last good M (bounded staleness, the CPU
  //      demotes within the readback lag) ----
  if(entry.patchSlot == 0xFFFFFFFFu)
  {
    return;
  }

  float P[12];
  for(uint k = 0; k < 12; k++)
  {
    P[k] = rigid ? M[k] : matrices.m[mBase + 12 + k];
  }

  // shaderio::RenderInstance.worldMatrix / worldMatrixI: glm::mat4x3,
  // column-major (12 floats: col0.xyz col1.xyz col2.xyz col3.xyz)
  {
    RawFloats wm = RawFloats(push.renderInstancesVa + uint64_t(entry.patchSlot) * uint64_t(push.riStrideBytes)
                             + uint64_t(push.riWorldMatrixOffset));
    wm.f[0] = P[0]; wm.f[1] = P[4]; wm.f[2] = P[8];    // col 0
    wm.f[3] = P[1]; wm.f[4] = P[5]; wm.f[5] = P[9];    // col 1
    wm.f[6] = P[2]; wm.f[7] = P[6]; wm.f[8] = P[10];   // col 2
    wm.f[9] = P[3]; wm.f[10] = P[7]; wm.f[11] = P[11]; // col 3 = translation

    // inverse (affine): I3 = inverse(A), It = -I3 * t
    const float det = P[0] * (P[5] * P[10] - P[6] * P[9])
                    - P[1] * (P[4] * P[10] - P[6] * P[8])
                    + P[2] * (P[4] * P[9] - P[5] * P[8]);
    const float invDet = abs(det) > 1e-20 ? 1.0 / det : 0.0;

    float I[9];
    I[0] = (P[5] * P[10] - P[6] * P[9]) * invDet;
    I[1] = (P[2] * P[9] - P[1] * P[10]) * invDet;
    I[2] = (P[1] * P[6] - P[2] * P[5]) * invDet;
    I[3] = (P[6] * P[8] - P[4] * P[10]) * invDet;
    I[4] = (P[0] * P[10] - P[2] * P[8]) * invDet;
    I[5] = (P[2] * P[4] - P[0] * P[6]) * invDet;
    I[6] = (P[4] * P[9] - P[5] * P[8]) * invDet;
    I[7] = (P[1] * P[8] - P[0] * P[9]) * invDet;
    I[8] = (P[0] * P[5] - P[1] * P[4]) * invDet;

    const vec3 it = -vec3(I[0] * P[3] + I[1] * P[7] + I[2] * P[11],
                          I[3] * P[3] + I[4] * P[7] + I[5] * P[11],
                          I[6] * P[3] + I[7] * P[7] + I[8] * P[11]);

    RawFloats wmi = RawFloats(push.renderInstancesVa + uint64_t(entry.patchSlot) * uint64_t(push.riStrideBytes)
                              + uint64_t(push.riWorldMatrixIOffset));
    wmi.f[0] = I[0]; wmi.f[1] = I[3]; wmi.f[2] = I[6];
    wmi.f[3] = I[1]; wmi.f[4] = I[4]; wmi.f[5] = I[7];
    wmi.f[6] = I[2]; wmi.f[7] = I[5]; wmi.f[8] = I[8];
    wmi.f[9] = it.x; wmi.f[10] = it.y; wmi.f[11] = it.z;

    // ---- winding: M replaces the CPU transform wholesale, so the CPU-staged
    //      flipWinding (computed from the CPU matrix, which is garbage for
    //      captured draws) is recomputed from det(A). A mirrored M flips
    //      triangle facing; without this, mirrored captured props render
    //      backface-culled/inverted (former V1 limitation).
    const bool mirrored = det < 0.0;
    {
      RawUints riPacked = RawUints(push.renderInstancesVa + uint64_t(entry.patchSlot) * uint64_t(push.riStrideBytes)
                                   + uint64_t(push.riFlipWindingOffset));
      uint packed = riPacked.u[0];
      const bool twoSided = ((packed >> 8) & 0xFFu) != 0u;  // byte 1 = twoSided
      packed = (packed & ~0xFFu) | ((!twoSided && mirrored) ? 1u : 0u);
      riPacked.u[0] = packed;
    }
    if(mirrored)
    {
      // VkAccelerationStructureInstanceKHR: dword at +52 packs
      // instanceShaderBindingTableRecordOffset:24 | flags:8. XOR the
      // TRIANGLE_FLIP_FACING bit (0x2) relative to the CPU-staged baseline -
      // the baseline was computed with an unmirrored transform, and the CPU
      // restages the dword every frame, so one XOR per frame is exact.
      RawUints tlasFlags = RawUints(push.tlasInstancesVa + uint64_t(entry.patchSlot) * 64ul + 52ul);
      tlasFlags.u[0] ^= (2u << 24);
    }
  }

  // VkAccelerationStructureInstanceKHR.transform: ROW-major 3x4 at offset 0,
  // stride 64
  {
    RawFloats tlas = RawFloats(push.tlasInstancesVa + uint64_t(entry.patchSlot) * 64ul);
    for(uint k = 0; k < 12; k++)
    {
      tlas.f[k] = P[k];
    }
  }
}
